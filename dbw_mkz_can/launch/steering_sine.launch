<?xml version="1.0"?>
<launch>
  <!-- Parameters -->
  <arg name="duration"   default="30.000" doc="Duration in seconds."/>
  <arg name="resolution" default="0.050"  doc="Time between recording values."/>
  <arg name="minimum"    default="-2.000"  doc="Minimum (leftmost) steering value, when oscillating."/>
  <arg name="maximum"    default="2.000"  doc="Maximum (rightmost) steering value, when oscillating."/>

  <!-- Base DBW Program -->
  <include file="$(find dbw_mkz_can)/launch/dbw.launch">
  </include>

  <!-- Main steering_sine.py script. required=true kills the other nodes when the script finishes. -->
  <node pkg="dbw_mkz_can" type="steering_sine.py" name="steering_sine" output="screen" required="true">
    <param name="duration"   value="$(arg duration)" />
    <param name="resolution" value="$(arg resolution)" />
    <param name="minimum"    value="$(arg minimum)" />
    <param name="maximum"    value="$(arg maximum)" />
  </node>

</launch>
